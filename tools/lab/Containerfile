# The DOSH development laboratory.
#
# Everything needed to build the supervisor, assemble the guest corpus, boot
# the result on virtual bare metal and run the acceptance tests. Enter it with
# ./lab from the repository root; nothing else needs installing on the host.
FROM docker.io/library/debian:trixie-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gcc libc6-dev make \
      nasm bcc elks-libc mtools \
      qemu-system-x86 ovmf \
      python3 python3-pytest \
 && rm -rf /var/lib/apt/lists/*

# Keep in step with rust-toolchain.toml.
ARG RUST_VERSION=1.91.0
ENV RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | CARGO_HOME=/opt/cargo sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "$RUST_VERSION" \
      --target x86_64-unknown-uefi \
      --component clippy,rustfmt \
 && chmod -R a+rX /opt/rustup /opt/cargo

WORKDIR /work
